PORT=8080
GIN_MODE=debug

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ecommerce_api
DB_SSLMODE=disable

JWT_SECRET= # string
JWT_EXPIRES_IN=24h  # string
REFRESH_TOKEN_EXPIRES_IN=72h # string

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT='http://localstack:4566'

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760  # 100 MB
UPLOAD_PROVIDER=s3

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@shop.com
