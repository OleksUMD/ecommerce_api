PORT=8080
GIN_MODE=debug
RATE_LIMIT=10

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ecommerce_api
DB_SSLMODE=disable

JWT_SECRET= # string
JWT_EXPIRES_IN=24h  # string
REFRESH_TOKEN_EXPIRES_IN=72h # string
MFA_ENC_KEY= # string
MFA_ISSUER='E-commerce API' # string

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT='http://localstack:4566'

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760  # 100 MB
UPLOAD_PROVIDER=s3

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@shop.com

# cache
REDIS_PASS=  # redis password
REDIS_PORT=6379
REDIS_HOST=cache
AUTH_SESSION_TTL=30  # minutes
