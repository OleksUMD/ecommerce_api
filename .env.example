PORT=8080
GIN_MODE=debug
RATE_LIMIT=10

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ecommerce_api
DB_SSLMODE=disable

JWT_SECRET=very_secret_string  # string
JWT_EXPIRES_IN=24h  # string with suffix h, m, s etc
REFRESH_TOKEN_EXPIRES_IN=72h  #  string with suffix h, m, s etc
MFA_ENC_KEY= # string
MFA_ISSUER='E-commerce API' # string

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=ecommerce-uploads
AWS_S3_ENDPOINT=http://localhost:9000
AWS_EVENT_QUEUE_NAME=ecommerce-events

UPLOAD_PATH=./uploads
MAX_UPLOAD_SIZE=10485760  # 100 MB
UPLOAD_PROVIDER=local

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@shop.com

# cache
REDIS_PASS=  # redis password
REDIS_PORT=6379
REDIS_HOST=localhost
AUTH_SESSION_TTL=30  # minutes
